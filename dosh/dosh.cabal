cabal-version:      3.0
name:               dosh
version:            24.6
synopsis:           The power of Haskell in your terminal!
homepage:           https://github.com/ners/dosh
license:            Apache-2.0
license-file:       LICENCE.md
author:             ners
maintainer:         ners@gmx.ch
category:           System
build-type:         Simple

common common
    default-language: GHC2021
    ghc-options:
        -Weverything
        -Wno-unsafe
        -Wno-missing-safe-haskell-mode
        -Wno-missing-export-lists
        -Wno-missing-import-lists
        -Wno-missing-kind-signatures
        -Wno-all-missed-specialisations
    default-extensions:
        ApplicativeDo
        Arrows
        BlockArguments
        DataKinds
        DefaultSignatures
        DeriveAnyClass
        DeriveGeneric
        DerivingStrategies
        DerivingVia
        ExplicitNamespaces
        LambdaCase
        NoFieldSelectors
        NoImplicitPrelude
        OverloadedLabels
        OverloadedRecordDot
        OverloadedStrings
        PackageImports
        RecordWildCards
        RecursiveDo
        StrictData
        TypeFamilies
        ViewPatterns
    build-depends:
        dosh-prelude,

library
    import:           common
    hs-source-dirs:   src
    exposed-modules:
        Dosh.CodeInput,
        Dosh.LSP.DiagnosticsClock,
        Dosh.LSP.SemanticTokensClock,
        Dosh.LSP.Session,
    other-modules:
        Prelude,
    build-depends:
        base,
        bytestring,
        containers,
        data-interval,
        extended-reals,
        extra,
        lens,
        lsp,
        lsp-client,
        lsp-types,
        prettyprinter,
        rhine,
        stm,
        terminal,
        terminal-widgets,
        terminal-widgets,
        text,
        text-rope,
        text-rope-zipper,
        unordered-containers,

executable dosh
    import:           common
    main-is:          Main.hs
    hs-source-dirs:   app
    ghc-options:
        -threaded
    build-depends:
        dosh,
